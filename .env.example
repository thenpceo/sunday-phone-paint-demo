# Optional locally: use an HTTPS tunnel origin so a phone can open the camera route.
PHONE_PAINT_PUBLIC_ORIGIN=https://your-secure-origin.example

# Required for reliable serverless cross-device sessions. Copy the HTTPS
# endpoint and token from the Upstash console. Vercel's KV_REST_API_* aliases
# are also supported as a fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
